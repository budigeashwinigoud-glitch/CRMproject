# =================================================================
# Belvo CRM & AI Lead Management System - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Environment & Core Security
# -----------------------------------------------------------------
ENVIRONMENT=development
# JWT secret for token signing (Must be 32+ characters in production)
JWT_SECRET=belvo-crm-super-secure-jwt-secret-key-change-in-production-2026
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:3000

# -----------------------------------------------------------------
# 2. Database Connection
# -----------------------------------------------------------------
# SQLite default:
DATABASE_URL=sqlite:///./crm.db
# PostgreSQL alternative (uncomment for production PostgreSQL):
# DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/belvo_crm

# -----------------------------------------------------------------
# 3. Initial Administrative Credentials (Bootstrap)
# -----------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@belvo.com
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_ADMIN_NAME=CRM Administrator

# -----------------------------------------------------------------
# 4. Webhook & Integration Credentials (Week 3)
# -----------------------------------------------------------------
# Meta Lead Ads App Secret (for HMAC-SHA256 signature verification)
META_APP_SECRET=belvo_meta_app_secret_test
# WhatsApp Cloud API Webhook Verify Token
WHATSAPP_VERIFY_TOKEN=belvo-crm-wa-verify-token-2026
# Website Inbound Form Shared Secret (Optional header verification)
WEBSITE_WEBHOOK_SECRET=

# Google Calendar OAuth (Optional live provider sync)
GOOGLE_CALENDAR_CLIENT_ID=
# Microsoft Graph / Outlook OAuth (Optional live provider sync)
MICROSOFT_GRAPH_CLIENT_ID=

# -----------------------------------------------------------------
# 5. Generative AI / LLM Configuration (Week 4)
# -----------------------------------------------------------------
# Optional: Set OpenAI or Gemini API key to enable live Generative AI drafts & summaries
# If omitted, system seamlessly runs calibrated feature-based ML scoring & templates
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# -----------------------------------------------------------------
# 6. Frontend Target (Vite)
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
