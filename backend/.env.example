# ==============================================================================
# BELVO CRM & AI LEAD MANAGEMENT SYSTEM — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./crm.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/belvo_crm

# JWT Authentication Secret Key & Algorithm
JWT_SECRET=your-secure-jwt-secret-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial CRM Admin Credentials (Seeded on first initialization)
INITIAL_ADMIN_EMAIL=admin@belvo.com
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
INITIAL_ADMIN_NAME=CRM Administrator

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Server Bind Configuration
HOST=127.0.0.1
PORT=8000
